{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "providers.schema.json",
  "title": "Provider Call Config",
  "description": "How long a picture call waits, and how the pauses grow. This is not a price and not a model name.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fal"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "fal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wait_seconds",
        "backoff_start_seconds",
        "backoff_step_seconds",
        "backoff_max_seconds",
        "progress_every_seconds"
      ],
      "properties": {
        "wait_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "backoff_start_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "backoff_step_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "backoff_max_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "progress_every_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string" }
      }
    }
  }
}
