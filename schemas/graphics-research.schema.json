{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graphics-research.schema.json",
  "title": "Graphics Research",
  "description": "What Title and Graphic Design read before designing. Each item is sourced from a production file, marked inferred, or marked as a designer proposal with a reference. The checker does not know which film this is.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "production_id", "items", "fingerprints", "draft_method", "model", "note", "written_at"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "production_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "fingerprints": { "$ref": "#/$defs/fingerprints" },
    "draft_method": { "type": "string", "enum": ["offline-deterministic", "model"] },
    "model": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "written_at": { "type": "string", "format": "date-time" },
    "subtitle_spec": { "$ref": "#/$defs/subtitle_spec" }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "topic", "text", "basis", "source_file", "source_field"],
      "properties": {
        "item_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "topic": { "type": "string", "enum": ["director", "setting", "genre", "period", "references"] },
        "text": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "enum": ["sourced", "inferred", "designer-proposal"] },
        "source_file": { "type": ["string", "null"], "minLength": 1 },
        "source_field": { "type": ["string", "null"], "minLength": 1 },
        "reference": { "type": ["string", "null"] },
        "family": { "type": "string", "minLength": 1 },
        "license_name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "enum": ["display", "sans-serif", "serif"] },
        "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "swatch_name": { "type": "string", "minLength": 1 },
        "swatch_use": { "type": "string", "enum": ["fill-missing-hex", "propose"] },
        "claim_kind": {
          "type": "string",
          "enum": ["convention", "artist", "lettering", "print", "credits", "layout", "other"]
        },
        "surface": { "type": "string", "enum": ["title", "poster", "key-art", "credits"] },
        "lettering_name": { "type": "string", "minLength": 1 },
        "lettering_style": { "type": "string", "minLength": 1 },
        "lettering_construction": { "type": "string", "minLength": 1 },
        "font_role": { "type": "string", "minLength": 1 },
        "duty": { "type": "string", "enum": ["primary", "mockup-stand-in", "glyph-fallback"] },
        "fallback_glyphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "swatch_scope": { "type": "string", "enum": ["print", "screen", "any"] }
      }
    },
    "file_print": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_bible", "look"],
      "properties": {
        "style_bible": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/file_print" }] },
        "look": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/file_print" }] },
        "reference_packs": {
          "type": "array",
          "items": { "$ref": "#/$defs/file_print" }
        }
      }
    },
    "subtitle_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["burned_in", "player"],
      "properties": {
        "burned_in": { "$ref": "#/$defs/burned_in" },
        "player": { "$ref": "#/$defs/player_subtitles" }
      }
    },
    "burned_in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "weight",
        "case",
        "color_name",
        "color",
        "edge",
        "position",
        "picture",
        "max_lines",
        "max_characters_per_line"
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "weight": { "type": "string", "minLength": 1 },
        "case": { "type": "string", "minLength": 1 },
        "color_name": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "edge": { "type": "string", "minLength": 1 },
        "position": { "type": "string", "minLength": 1 },
        "picture": { "type": "string", "minLength": 1 },
        "max_lines": { "type": "integer", "minimum": 1 },
        "max_characters_per_line": { "type": "integer", "minimum": 1 }
      }
    },
    "player_subtitles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "files", "note"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["srt", "vtt"] }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
