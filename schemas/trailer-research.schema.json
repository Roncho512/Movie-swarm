{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trailer-research.schema.json",
  "title": "Trailer Research",
  "description": "What the Trailer Editor read before planning. Each item is sourced from a production file or marked inferred. The checker does not know which film this is.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "production_id", "items", "draft_method", "model", "note", "written_at"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "production_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "topic", "text", "basis", "source_file", "source_field"],
        "properties": {
          "item_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "topic": {
            "type": "string",
            "enum": ["treatment", "director", "brand", "genre", "period", "trailer-form"]
          },
          "text": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "enum": ["sourced", "inferred"] },
          "source_file": { "type": ["string", "null"] },
          "source_field": { "type": ["string", "null"] }
        }
      }
    },
    "draft_method": { "type": "string", "enum": ["offline-deterministic", "model"] },
    "model": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "written_at": { "type": "string", "format": "date-time" }
  }
}
