{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "camera-package.schema.json",
  "title": "Camera Package",
  "description": "Lenses, framing, and lighting for one production, copied from that production's look. Empty lenses mean the production did not name any.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "production_id",
    "look_name",
    "summary",
    "lenses",
    "framing",
    "lighting",
    "source"
  ],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "production_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "look_name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "aspect_ratio": { "type": "string" },
    "lenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lens_id", "name", "use"],
        "properties": {
          "lens_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "focal_length": { "type": "string" },
          "use": { "type": "string", "minLength": 1 }
        }
      }
    },
    "framing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lighting": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "palette": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "lens_note": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "draft_method": { "type": "string", "enum": ["offline-deterministic", "model"] },
    "model": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
