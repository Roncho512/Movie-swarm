{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-reference.schema.json",
  "title": "Design reference pack",
  "description": "Offline genre and period notes for Title and Graphic Design. The engine matches a pack from the production's own genre, tone, and look. A pack does not name a film. Each claim cites a URL. A font cites a license that allows use in a film.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "match"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string" },
    "note": { "type": "string" },
    "match": { "$ref": "#/$defs/match" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "fonts": {
      "type": "array",
      "items": { "$ref": "#/$defs/font" }
    },
    "colors": {
      "type": "array",
      "items": { "$ref": "#/$defs/color" }
    },
    "layouts": {
      "type": "array",
      "items": { "$ref": "#/$defs/layout" }
    },
    "safe_area": { "$ref": "#/$defs/safe" },
    "custom_lettering": { "$ref": "#/$defs/lettering" }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "always": { "type": "boolean" },
        "terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 }
        },
        "year_min": { "type": "integer" },
        "year_max": { "type": "integer" },
        "require_year": { "type": "boolean" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "topic", "kind", "text", "url"],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "topic": {
          "type": "string",
          "enum": ["director", "setting", "genre", "period", "references"]
        },
        "kind": {
          "type": "string",
          "enum": ["convention", "artist", "lettering", "print", "credits", "layout", "other"]
        },
        "surface": {
          "type": "string",
          "enum": ["title", "poster", "key-art", "credits"]
        },
        "text": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "family", "category", "license_name", "license_url", "source_url", "note"],
      "properties": {
        "role": { "type": "string", "enum": ["title", "credits", "subtitles", "marketing"] },
        "family": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "enum": ["display", "sans-serif", "serif"] },
        "license_name": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "format": "uri" },
        "source_url": { "type": "string", "format": "uri" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hex", "use", "url", "note"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "use": { "type": "string", "enum": ["fill-missing-hex", "propose"] },
        "url": { "type": "string", "format": "uri" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_id", "surface", "text", "url"],
      "properties": {
        "layout_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "surface": { "type": "string", "enum": ["title", "poster", "key-art", "credits"] },
        "text": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "safe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_inset_percent", "graphics_inset_percent", "source_name", "url", "note"],
      "properties": {
        "action_inset_percent": { "type": "number", "minimum": 0, "maximum": 40 },
        "graphics_inset_percent": { "type": "number", "minimum": 0, "maximum": 40 },
        "source_name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "lettering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "style", "construction", "urls"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "style": { "type": "string", "minLength": 1 },
        "construction": { "type": "string", "minLength": 1 },
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
