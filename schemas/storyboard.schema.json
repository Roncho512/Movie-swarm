{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "Storyboard",
  "description": "Board prompts and an animatic plan made from the approved treatment. An animatic is the boards in order, with a duration on each one. Image generation is a separate step and can be left unrun.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "production_id", "frames", "animatic", "image_generation"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "production_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "shot_list_path": { "type": "string" },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "description": "The camera package, stated once. Shots do not repeat it.",
      "properties": {
        "look_name": { "type": "string" },
        "summary": { "type": "string" },
        "lenses": { "type": "array", "items": { "type": "string" } },
        "framing": { "type": "array", "items": { "type": "string" } },
        "lighting": { "type": "array", "items": { "type": "string" } },
        "palette": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Shot-length check. A hold named in the screenplay may sit outside the range.",
      "required": ["minimum_seconds", "maximum_seconds", "note"],
      "properties": {
        "minimum_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "adjustments": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "tag_notes": {
      "type": "array",
      "description": "Characters or props carried onto a shot, and shots the board will not guess.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "kind", "detail"],
        "properties": {
          "shot_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kind": {
            "type": "string",
            "enum": ["inherited-character", "carried-prop", "needs-review"]
          },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "featured_placements": {
      "type": "array",
      "description": "Shots that show a hero prop named in the brief, and why. The reading copy calls these hero prop moments.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "product", "why"],
        "properties": {
          "shot_id": { "type": "string", "minLength": 1 },
          "product": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "shot_id", "scene_id", "board_prompt", "image_status"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "shot_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "scene_id": { "type": "string", "minLength": 1 },
          "board_prompt": { "type": "string", "minLength": 1 },
          "shot_type": { "type": "string" },
          "what_we_see": { "type": "string" },
          "camera": { "type": "string" },
          "transition": { "type": "string" },
          "props_in_frame": { "type": "array", "items": { "type": "string" } },
          "duration_seconds": { "type": "number", "minimum": 0.5 },
          "reference_images": {
            "type": "array",
            "description": "Locked prop reference paths for providers that accept an image reference.",
            "items": { "type": "string", "minLength": 1 }
          },
          "characters_in_shot": {
            "type": "array",
            "description": "character_id values visible in this shot. Generation uses them to pull face photos.",
            "items": { "type": "string", "minLength": 1 }
          },
          "location_id": {
            "type": "string",
            "description": "location_id from locations/location-lock.json when this shot should use that place's photos."
          },
          "location": { "type": "string" },
          "reference_from": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional explicit lock ids. An empty list for a key pulls nothing from that lock. A missing key is inferred.",
            "properties": {
              "characters": { "type": "array", "items": { "type": "string" } },
              "location": { "type": "string" },
              "props": { "type": "array", "items": { "type": "string" } }
            }
          },
          "image_status": { "type": "string", "enum": ["not-generated", "fake-client"] },
          "image_ref": { "type": ["string", "null"] }
        }
      }
    },
    "animatic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_duration_seconds", "order"],
      "properties": {
        "total_duration_seconds": { "type": "number", "minimum": 0 },
        "order": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved"],
      "description": "Approved only when the Line Producer records Ron's yes on the previs gate."
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "by": { "type": ["string", "null"] },
        "at": { "type": ["string", "null"], "format": "date-time" },
        "note": { "type": "string" }
      }
    },
    "image_generation": { "type": "string", "enum": ["not-run", "fake-client"] },
    "draft_method": { "type": "string", "enum": ["offline-deterministic", "model"] },
    "model": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
