{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "Storyboard",
  "description": "Board prompts and an animatic plan made from the approved treatment. An animatic is the boards in order, with a duration on each one. Image generation is a separate step and can be left unrun.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "production_id", "frames", "animatic", "image_generation"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "production_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "shot_list_path": { "type": "string" },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "shot_id", "scene_id", "board_prompt", "image_status"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "shot_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "scene_id": { "type": "string", "minLength": 1 },
          "board_prompt": { "type": "string", "minLength": 1 },
          "duration_seconds": { "type": "number", "minimum": 0.5 },
          "image_status": { "type": "string", "enum": ["not-generated", "fake-client"] },
          "image_ref": { "type": ["string", "null"] }
        }
      }
    },
    "animatic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_duration_seconds", "order"],
      "properties": {
        "total_duration_seconds": { "type": "number", "minimum": 0 },
        "order": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "type": "string" }
      }
    },
    "image_generation": { "type": "string", "enum": ["not-run", "fake-client"] },
    "draft_method": { "type": "string", "enum": ["offline-deterministic", "model"] },
    "model": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
