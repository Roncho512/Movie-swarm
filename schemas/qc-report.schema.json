{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qc-report.schema.json",
  "title": "QC Report",
  "description": "Pass or fail for each delivery check: duration, resolution, frame rate, loudness, black frames, frozen frames, caption timing, and graphics when a graphics package is present. A skipped check means the file or the tool was missing. This file does not name a film.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "production_id", "kind", "created_at", "verdict", "spent_usd", "cut_runtime_seconds", "checks", "draft_method"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "production_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "kind": { "type": "string", "const": "qc-report" },
    "created_at": { "type": "string", "format": "date-time" },
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "spent_usd": { "type": "number", "const": 0 },
    "cut_runtime_seconds": { "type": "number", "minimum": 0 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "target", "kind", "status", "detail"],
        "properties": {
          "check_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "target": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["file", "duration", "resolution", "frame-rate", "loudness", "black", "frozen", "captions", "graphics", "trailer"]
          },
          "status": { "type": "string", "enum": ["pass", "fail", "skipped"] },
          "detail": { "type": "string" }
        }
      }
    },
    "draft_method": { "type": "string", "enum": ["offline-deterministic"] }
  }
}
