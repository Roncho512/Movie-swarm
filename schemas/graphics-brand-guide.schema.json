{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graphics-brand-guide.schema.json",
  "title": "Brand Guide",
  "description": "Per-film graphic rules built from graphics research. A rule traces to a research item. Graphics wait until status is approved. The checker does not know which film this is.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "production_id",
    "status",
    "research",
    "fonts",
    "palette",
    "wordmark",
    "layout",
    "image_treatment",
    "dos",
    "donts",
    "fingerprints",
    "change_log",
    "rules_fingerprint",
    "draft_method",
    "model",
    "note",
    "written_at"
  ],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "production_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "status": { "type": "string", "enum": ["draft", "approved"] },
    "research": { "type": "string", "minLength": 1 },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "credits", "subtitles", "marketing"],
      "properties": {
        "title": { "$ref": "#/$defs/font" },
        "credits": { "$ref": "#/$defs/font" },
        "subtitles": { "$ref": "#/$defs/font" },
        "marketing": { "$ref": "#/$defs/font" }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/color" }
    },
    "wordmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "rules"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_area", "rules"],
      "properties": {
        "safe_area": { "type": "string", "minLength": 1 },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "image_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "dos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "donts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_bible", "look"],
      "properties": {
        "style_bible": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/file_print" }] },
        "look": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/file_print" }] }
      }
    },
    "change_log": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/change" }
    },
    "rules_fingerprint": { "type": "string", "minLength": 1 },
    "draft_method": { "type": "string", "enum": ["offline-deterministic", "model"] },
    "model": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "written_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "licensing", "trace"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "licensing": { "type": "string", "minLength": 1 },
        "trace": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "trace"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "trace": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "text", "trace"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "text": { "type": "string", "minLength": 1 },
        "trace": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "file_print": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "at", "change"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "at": { "type": "string", "format": "date-time" },
        "change": { "type": "string", "minLength": 1 }
      }
    }
  }
}
