{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graphics-brand-guide.schema.json",
  "title": "Brand Guide",
  "description": "Per-film graphic rules built from graphics research. Each font, color, and rule is labeled as coming from the production documents or as a designer proposal. A rule traces to a research item. Graphics wait until status is approved. The checker does not know which film this is.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "production_id",
    "status",
    "research",
    "fonts",
    "palette",
    "wordmark",
    "layout",
    "image_treatment",
    "dos",
    "donts",
    "fingerprints",
    "change_log",
    "rules_fingerprint",
    "draft_method",
    "model",
    "note",
    "written_at"
  ],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "production_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "status": { "type": "string", "enum": ["draft", "approved"] },
    "research": { "type": "string", "minLength": 1 },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "credits", "subtitles", "marketing"],
      "properties": {
        "title": { "$ref": "#/$defs/font" },
        "credits": { "$ref": "#/$defs/font" },
        "subtitles": { "$ref": "#/$defs/font" },
        "marketing": { "$ref": "#/$defs/font" },
        "subheads": { "$ref": "#/$defs/font" },
        "body": { "$ref": "#/$defs/font" },
        "billing": { "$ref": "#/$defs/font" },
        "player_subtitles": { "$ref": "#/$defs/font" }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/color" }
    },
    "wordmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "rules"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_area", "rules"],
      "properties": {
        "safe_area": { "type": "string", "minLength": 1 },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "image_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "dos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "donts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_bible", "look"],
      "properties": {
        "style_bible": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/file_print" }] },
        "look": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/file_print" }] },
        "reference_packs": {
          "type": "array",
          "items": { "$ref": "#/$defs/file_print" }
        }
      }
    },
    "change_log": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/change" }
    },
    "rules_fingerprint": { "type": "string", "minLength": 1 },
    "surfaces": { "$ref": "#/$defs/surfaces" },
    "notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "custom_title": { "$ref": "#/$defs/custom_title" },
    "subtitle_spec": { "$ref": "#/$defs/subtitle_spec" },
    "draft_method": { "type": "string", "enum": ["offline-deterministic", "model"] },
    "model": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "written_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "licensing", "trace", "provenance", "reference"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "licensing": { "type": "string", "minLength": 1 },
        "trace": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "provenance": { "type": "string", "enum": ["SOURCED FROM PRODUCTION DOCS", "DESIGNER PROPOSAL"] },
        "reference": { "type": ["string", "null"] },
        "category": { "type": "string", "enum": ["display", "sans-serif", "serif"] },
        "alternates": {
          "type": "array",
          "items": { "$ref": "#/$defs/alternate_font" }
        },
        "stand_ins": {
          "type": "array",
          "items": { "$ref": "#/$defs/alternate_font" }
        },
        "glyph_fallback": { "$ref": "#/$defs/glyph_fallback" }
      }
    },
    "glyph_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "licensing", "provenance", "reference", "trace", "glyphs"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "licensing": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "enum": ["SOURCED FROM PRODUCTION DOCS", "DESIGNER PROPOSAL"] },
        "reference": { "type": ["string", "null"] },
        "trace": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category": { "type": "string", "enum": ["display", "sans-serif", "serif"] },
        "glyphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "alternate_font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "licensing", "provenance", "reference"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "licensing": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "enum": ["SOURCED FROM PRODUCTION DOCS", "DESIGNER PROPOSAL"] },
        "reference": { "type": ["string", "null"] },
        "category": { "type": "string", "enum": ["display", "sans-serif", "serif"] },
        "trace": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "trace", "provenance", "reference"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "trace": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "provenance": { "type": "string", "enum": ["SOURCED FROM PRODUCTION DOCS", "DESIGNER PROPOSAL"] },
        "reference": { "type": ["string", "null"] },
        "scope": { "type": "string", "enum": ["print", "screen", "any"] }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "text", "trace", "provenance", "reference"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "text": { "type": "string", "minLength": 1 },
        "trace": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "provenance": { "type": "string", "enum": ["SOURCED FROM PRODUCTION DOCS", "DESIGNER PROPOSAL"] },
        "reference": { "type": ["string", "null"] }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "poster": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "key_art": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "credits": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
      }
    },
    "custom_title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "style", "construction", "built", "provenance", "reference", "trace"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "style": { "type": "string", "minLength": 1 },
        "construction": { "type": "string", "minLength": 1 },
        "built": { "type": "boolean", "const": false },
        "provenance": { "type": "string", "const": "DESIGNER PROPOSAL" },
        "reference": { "type": "string", "minLength": 1 },
        "trace": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "file_print": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "at", "change"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "at": { "type": "string", "format": "date-time" },
        "change": { "type": "string", "minLength": 1 }
      }
    },
    "subtitle_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["burned_in", "player"],
      "properties": {
        "burned_in": { "$ref": "#/$defs/burned_in" },
        "player": { "$ref": "#/$defs/player_subtitles" }
      }
    },
    "burned_in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "weight",
        "case",
        "color_name",
        "color",
        "edge",
        "position",
        "picture",
        "max_lines",
        "max_characters_per_line"
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "weight": { "type": "string", "minLength": 1 },
        "case": { "type": "string", "minLength": 1 },
        "color_name": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "edge": { "type": "string", "minLength": 1 },
        "position": { "type": "string", "minLength": 1 },
        "picture": { "type": "string", "minLength": 1 },
        "max_lines": { "type": "integer", "minimum": 1 },
        "max_characters_per_line": { "type": "integer", "minimum": 1 }
      }
    },
    "player_subtitles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "files", "note"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["srt", "vtt"] }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
