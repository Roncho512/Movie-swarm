# Copy this file to .env and fill the values on your machine.
# The commands in scripts/ load .env at start. A variable already set in the shell wins.
# Do not commit .env. The values below are empty on purpose.

ANTHROPIC_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=

# Optional folder for finished media and the delivery package.
# A non-interactive shell does not read ~/.zshrc, so put the path here when
# doctor and the film commands should see it. Leave it empty to keep files
# in the production folder. config/assets.json is the other place.
# Do not commit a real path.
MOVIE_SWARM_ASSET_ROOT=

# Folder that holds each film's working folder, outside this repo.
# A production name is this folder plus the name. When this is empty, the
# film commands use MOVIE_SWARM_ASSET_ROOT. Leave both empty and pass a path.
# A non-interactive shell does not read ~/.zshrc. Do not commit a real path.
MOVIE_SWARM_FILMS_ROOT=
